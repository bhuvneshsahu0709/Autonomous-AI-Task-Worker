# Required for the LLM-driven agent. Without it the server still runs and the
# sandbox + scripted planner work, but `planner=llm` runs will fail fast.
ANTHROPIC_API_KEY=sk-ant-...

# --- model ---
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=high            # low | medium | high | xhigh | max
AGENT_MAX_TOKENS=8000

# --- autonomy / safety ---
AUTONOMY_LEVEL=standard      # supervised | standard | autonomous
APPROVAL_AMOUNT_THRESHOLD=10000

# --- budgets ---
MAX_STEPS=40
MAX_SECONDS=900
MAX_CONSECUTIVE_ERRORS=4
MAX_VERIFICATION_ROUNDS=2

# --- browser ---
BROWSER_HEADLESS=true
BROWSER_SLOW_MO_MS=0

# --- sandbox fault injection (comma separated, empty = clean world) ---
# flaky_login | slow_invoice | strict_validation | api_rate_limit
SANDBOX_FAULTS=flaky_login,strict_validation

HOST=127.0.0.1
PORT=8000
